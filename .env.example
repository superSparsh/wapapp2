APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=true
APP_URL=http://localhost
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wapapp_master
DB_USERNAME=root
DB_PASSWORD=

# Legacy WapApp database (help-center + customer migrate)
LEGACY_DB_CONNECTION=legacy
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=8889
LEGACY_DB_DATABASE=wapapp
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=root
LEGACY_APP_PATH=/Applications/MAMP/htdocs/wapdev.tittu.in
# Optional: public URL of the old app (resolves relative /upload/... template media)
# LEGACY_APP_URL=https://old.example.com
# LEGACY_MIGRATE_PILOT_MAX_SUBS=5000
# LEGACY_MIGRATE_CONTACT_CHUNK=500

# Seeded super-admin login (admin panel). Password left blank → random 28-char password printed after db:seed.
ADMIN_SEED_EMAIL=superadmin@wapapp.in
ADMIN_SEED_PASSWORD=

# Emails that should see tenant UI → Admin View (comma-separated), plus any active admins row with matching email
# ADMIN_VIEW_EMAILS=you@tittu.in,ops@tittu.in

SESSION_DRIVER=database
SESSION_CONNECTION="${DB_CONNECTION}"
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

REVERB_APP_ID=wapapp
REVERB_APP_KEY=wapapp-local-key
REVERB_APP_SECRET=wapapp-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

INBOX_REALTIME_ENABLED=true
INBOX_REALTIME_FALLBACK_POLL_MS=120000

# Inbox Microservice Integration
INBOX_SERVICE_ENABLED=false
INBOX_SERVICE_BASE_URL=http://127.0.0.1:8001/api/v1
INBOX_SERVICE_TOKEN=default-inbox-service-secret-token
SERVICE_AUTH_TOKEN=default-inbox-service-secret-token
INBOX_SERVICE_TIMEOUT=5
INBOX_SERVICE_FALLBACK_TO_LOCAL=true
INBOX_SERVICE_RETRY_ATTEMPTS=2
INBOX_SERVICE_RETRY_BACKOFF_MS=100

# Campaign Microservice Integration
CAMPAIGN_SERVICE_ENABLED=false
CAMPAIGN_SERVICE_BASE_URL=http://127.0.0.1:8002/api/v1
CAMPAIGN_SERVICE_TOKEN=default-campaign-service-secret-token
CAMPAIGN_SERVICE_TIMEOUT=5
CAMPAIGN_SERVICE_FALLBACK_TO_LOCAL=true
CAMPAIGN_SERVICE_RETRY_ATTEMPTS=2
CAMPAIGN_SERVICE_RETRY_BACKOFF_MS=100

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# OCI heavy workers (see docs/OCI-Heavy-Workers-Architecture.md)
# Keep OCI_WORKERS_ENABLED=false until OCI Horizon (HORIZON_ROLE=oci-heavy) is healthy.
OCI_WORKERS_ENABLED=false
HORIZON_ROLE=all
CAMPAIGN_QUEUE=campaign
OCI_STATUS_QUEUE=status
OCI_IMPORT_QUEUE=import
OCI_IMPORT_ROW_THRESHOLD=30000
OCI_STATUS_QUEUE_ONLY=true

# Admin → Queues server ops (supervisor / apache need passwordless sudo for PHP-FPM user)
ADMIN_OPS_SUDO=true
ADMIN_OPS_SUPERVISOR_PROGRAM=horizon
ADMIN_OPS_APACHE_SERVICE=apache2
# ADMIN_OPS_APACHECTL=/usr/sbin/apache2ctl
# ADMIN_OPS_SUPERVISORCTL=/usr/bin/supervisorctl

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mobile OTP login: log | mail | whatsapp
LOGIN_OTP_DRIVER=log
LOGIN_OTP_TTL=600
LOGIN_OTP_RESEND_COOLDOWN=60

# WhatsApp OTP (legacy-compatible; required when LOGIN_OTP_DRIVER=whatsapp)
LOGIN_OTP_WHATSAPP_FROM=
LOGIN_OTP_WHATSAPP_TEMPLATE_CODE=
LOGIN_OTP_WHATSAPP_CUST_SPACE_ID=
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_ENDPOINT=cams.ap-southeast-1.aliyuncs.com

# Razorpay (subscription + wallet — only payment gateway)
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_GST_RATE=18

# Meta WhatsApp USD rate card (optional override; leave empty to auto-discover)
META_USD_PRICING_CSV_URL=

# Meta Oct 1 2026: charge service (session) msgs + utility inside 24h CSW (YYYY-MM-DD, Asia/Kolkata)
META_SERVICE_BILLING_STARTS_AT=2026-10-01

# Zoho Books — paid invoice after Razorpay wallet recharge (legacy parity)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ORGANIZATION_ID=
ZOHO_REFRESH_TOKEN_INVOICE=
ZOHO_BOOKS_API_BASE=https://www.zohoapis.com/books/v3
ZOHO_BOOKS_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_WALLET_LINE_NAME="Wallet credit (prepaid)"
ZOHO_WALLET_LINE_TAX_ID=
ZOHO_WALLET_INVOICE_CURRENCY_ID=
ZOHO_WALLET_RAZORPAY_PAYMENT_MODE=razorpay

INBOX_SERVICE_ENABLED=false
INBOX_SERVICE_BASE_URL=http://127.0.0.1:8001/api/v1
INBOX_SERVICE_TOKEN=default-inbox-service-secret-token

CAMPAIGN_SERVICE_ENABLED=false
CAMPAIGN_SERVICE_BASE_URL=http://127.0.0.1:8002/api/v1
CAMPAIGN_SERVICE_TOKEN=default-campaign-service-secret-token

TEMPLATE_SERVICE_ENABLED=false
TEMPLATE_SERVICE_BASE_URL=http://127.0.0.1:8003/api/v1
TEMPLATE_SERVICE_TOKEN=default-template-service-secret-token

# Python AI / Knowledge Base (FastAPI + Chroma — KB source of truth)
PYTHON_AI_URL=http://127.0.0.1:5005
PYTHON_AI_TIMEOUT=90
PYTHON_AI_CONNECT_TIMEOUT=10
PYTHON_AI_ENABLED=true

# Operational alerts — same keys as legacy where possible
# Admin email list (plan expiry, wallet, cloud bill, digests, etc.)
PLAN_EXPIRY_NOTIFICATION=
# Developer WhatsApp numbers (error / ops alerts), comma-separated
WHATSAPP_TO_NUMBERS=
# Admin WhatsApp numbers for plan expiry (falls back to WHATSAPP_TO_NUMBERS)
WHATSAPP_TO_NUMBERS_PLAN_EXPIRATION=
# Platform WhatsApp "From" for alert templates (can reuse login OTP line)
OPERATIONAL_ALERTS_WA_FROM=
OPERATIONAL_ALERTS_WA_CUST_SPACE_ID=
ALERT_LOW_WALLET_THRESHOLD=100
WA_HEALTH_DIGEST_EMAILS=
WA_HEALTH_ALERT_WEBHOOK_URL=
ACCOUNT_EXPIRATION_REPORT_EMAILS=

