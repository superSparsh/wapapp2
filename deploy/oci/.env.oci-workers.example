# =============================================================================
# OCI heavy workers — merge these into the worker host .env (never commit secrets)
# =============================================================================

# Master switch: only true on WEB after OCI Horizon is healthy
OCI_WORKERS_ENABLED=true

# web | oci-heavy | all
# - oci-heavy on OCI VM
# - web on main app (after OCI is up)
# - all = emergency / single-host fallback
HORIZON_ROLE=oci-heavy

# Optional distinct Horizon UI name
HORIZON_NAME=oci-heavy

CAMPAIGN_QUEUE=campaign
OCI_STATUS_QUEUE=status
OCI_IMPORT_QUEUE=import
INBOUND_MESSAGE_QUEUE=messages
OCI_IMPORT_ROW_THRESHOLD=30000
OCI_STATUS_QUEUE_ONLY=true

# Must match production Redis + MySQL (same as web app)
# REDIS_HOST=...
# REDIS_PASSWORD=...
# DB_HOST=...
# DB_DATABASE=...
# DB_USERNAME=...
# DB_PASSWORD=...

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Workers do not serve HTTP — keep APP_ENV=production
APP_ENV=production

# =============================================================================
# Ephemeral campaign Container Instance (optional — usually set on WEB host)
# Creates CI when first campaign starts; destroys after last campaign finishes.
# NEVER commit real private keys / auth tokens.
# =============================================================================
# OCI_EPHEMERAL_CONTAINERS=false
# OCI_EPHEMERAL_DRIVER=log
# OCI_EPHEMERAL_GRACE_SECONDS=120
# OCI_PROVISIONING_QUEUE=provisioning
#
# Tekkpro / saasvoiceai prod (ap-mumbai-1) — non-secret IDs only:
# OCI_REGION=ap-mumbai-1
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaex6fnpgmw4jhy7gvczfxd2hv6rebjxp6iujrji5jtjj6fv3jkizq
# OCI_USER_OCID=ocid1.user.oc1..aaaaaaaa3zamup5ez643rtkdzlwhr6kevdhdrmjqdf4hbih4qequof4ycjvq
# OCI_FINGERPRINT=8b:2d:de:9a:e2:58:51:6a:de:18:f1:8b:1f:81:78:6e
# OCI_PRIVATE_KEY_PATH=/home/ubuntu/.oci/support@tekkonnectpro.com-prod-apikey-private.pem
# OCI_COMPARTMENT_ID=           # REQUIRED — still missing (tenancy root or app compartment OCID)
# OCI_AVAILABILITY_DOMAIN=      # REQUIRED — e.g. from: oci iam availability-domain list --compartment-id <tenancy>
# OCI_SUBNET_ID=ocid1.subnet.oc1.ap-mumbai-1.aaaaaaaaqbu5yylzoy7ikbm3te2hl2znpqqkfi2e2kjvftm2vimavq4apdsa
# OCI_CI_IMAGE_URL=bom.ocir.io/bmue9nxcdpso/wapapp-prod:latest
# OCI_CI_SHAPE=CI.Standard.E4.Flex
# OCI_CI_OCPUS=1
# OCI_CI_MEMORY_GB=4
# OCI_CI_ASSIGN_PUBLIC_IP=false
#
# App VM (long-lived Horizon / shared Redis): 140.238.241.148 / 10.0.0.203
# DB VM (private): 10.0.0.253
