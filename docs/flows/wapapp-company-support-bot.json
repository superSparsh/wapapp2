    {
      "id": "faq_billing",
      "type": "welcomeMessage",
      "position": {
        "x": 780,
        "y": 40
      },
      "data": {
        "messageType": "text",
        "triggerKeyword": "",
        "welcomeMessage": "Billing / Payments\n\n• Plan upgrade/downgrade dashboard → Billing se hota hai.\n• Invoice email usually account email pe aati hai.\n• Payment fail ho to 10–15 min baad retry karein; phir bhi issue ho to agent se baat karein.\n\nRefund / charge dispute ke liye agent recommend hai.",
        "label": "FAQ Billing"
      }
    },
    {
      "id": "faq_technical",
      "type": "welcomeMessage",
      "position": {
        "x": 780,
        "y": 200
      },
      "data": {
        "messageType": "text",
        "triggerKeyword": "",
        "welcomeMessage": "Technical help\n\n• Template pending/rejected → Meta category/content check karein.\n• Messages deliver nahi ho rahe → line quality, 24h window, aur STOP keyword check karein.\n• QR / embedded signup issues → Integration / Onboarding screen refresh karke try karein.\n\nExact error text bhejo to AI ya agent better help kar sakte hain.",
        "label": "FAQ Technical"
      }
    },
    {
      "id": "faq_account",
      "type": "welcomeMessage",
      "position": {
        "x": 780,
        "y": 360
      },
      "data": {
        "messageType": "text",
        "triggerKeyword": "",
        "welcomeMessage": "Account / WhatsApp line\n\n• Login OTP email/spam folder check karein.\n• Line disconnect dikhe to Integration pe reconnect karein.\n• Team member access → Team settings se role assign hota hai.\n\nAccount ownership change / transfer ke liye agent se baat karein.",
        "label": "FAQ Account"
      }
    },
