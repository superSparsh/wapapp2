    {
      "id": "faq_billing",
      "type": "welcomeMessage",
      "position": { "x": 780, "y": 40 },
      "data": {
        "messageType": "text",
        "triggerKeyword": "",
        "welcomeMessage": "Billing & payments\n\n• Upgrade or change your plan from Dashboard → Billing.\n• Invoices are usually sent to your account email.\n• If a payment fails, wait 10–15 minutes and try again. If it still fails, please talk to an agent.\n\nFor refunds or billing disputes, we recommend speaking with an agent.",
        "label": "FAQ Billing"
      }
    },
    {
      "id": "faq_technical",
      "type": "welcomeMessage",
      "position": { "x": 780, "y": 200 },
      "data": {
        "messageType": "text",
        "triggerKeyword": "",
        "welcomeMessage": "Technical help\n\n• Template pending or rejected — review Meta’s category and content guidelines.\n• Messages not delivering — check line quality, the 24-hour messaging window, and STOP keywords.\n• QR or embedded signup issues — refresh Integration / Onboarding and try again.\n\nShare the exact error message so AI or an agent can help you faster.",
        "label": "FAQ Technical"
      }
    },
    {
      "id": "faq_account",
      "type": "welcomeMessage",
      "position": { "x": 780, "y": 360 },
      "data": {
        "messageType": "text",
        "triggerKeyword": "",
        "welcomeMessage": "Account & WhatsApp line\n\n• Check your email (and spam folder) for login OTPs.\n• If a line shows disconnected, reconnect it under Integration.\n• Team member access is managed in Team settings.\n\nFor account ownership changes or transfers, please talk to an agent.",
        "label": "FAQ Account"
      }
    },
    {
      "id": "followup_faq",
