APP_NAME="Campaign Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8002

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

QUEUE_CONNECTION=redis
CACHE_STORE=redis

CAMPAIGN_SERVICE_TOKEN=default-campaign-service-secret-token
SERVICE_AUTH_TOKEN=default-campaign-service-secret-token

INBOX_SERVICE_URL=http://127.0.0.1:8001/api/v1
INBOX_SERVICE_TOKEN=default-inbox-service-secret-token
INBOX_SERVICE_TIMEOUT=5

# Hybrid send: pending >= threshold uses mass API, else simple API
CAMPAIGN_MASS_THRESHOLD=50
CAMPAIGN_MASS_BATCH_SIZE=1000
CAMPAIGN_DISPATCH_BATCH_SIZE=100
CAMPAIGN_QUEUE=default

ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=
ALIBABA_ENDPOINT=cams.ap-southeast-1.aliyuncs.com
WHATSAPP_DEFAULT_LANGUAGE=en_GB
